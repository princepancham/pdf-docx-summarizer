# Copy to .env for local development. Never commit .env.
APP_NAME=PDF & DOCX Summarizer
APP_ENV=dev
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
# Optional in Phase 1. Required from Phase 4 onwards. Leave empty for now.
OPENROUTER_API_KEY=
