# Copy to .env for local development. Never commit .env.
APP_NAME=PDF & DOCX Summarizer
APP_ENV=dev
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
# OpenRouter AI summarization (required for POST /api/documents/summarize).
# Never commit .env with a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=45
OPENROUTER_MAX_TOKENS=500
# Text chunking for long documents.
CHUNK_CHARS=4000
CHUNK_OVERLAP=200
MAX_CHUNKS=12
# Agent behavior (profile -> plan -> execute -> evaluate, max 1 repair).
AGENT_MAX_REPAIRS=1
AGENT_PLAN_TOKENS=150
AGENT_MIN_COVERAGE=0.3
# SQLite history database (file is git-ignored).
DATABASE_URL=sqlite:///./documents.db
